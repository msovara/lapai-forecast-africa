# Compatibility shim for sites that still say "Singularity".
# Canonical recipe: containers/Apptainer.def
#
# Build either file the same way (from repo root):
#   apptainer build mvula-v5.sif containers/Apptainer.def
#   singularity build mvula-v5.sif containers/Apptainer.def
#   singularity build mvula-v5.sif containers/Singularity.def
#
# This file duplicates the Apptainer recipe so older CHPC docs keep working.

Bootstrap: docker
From: ubuntu:22.04

%labels
    Author msovara
    Project Mvula
    Freeze trackb-v5-c4e
    ClaimBoundary "Case A AF t2m only — no free-run 10-day claim"
    CanonicalDef containers/Apptainer.def

%help
    Mvula v5 - AIFS-derived lightweight CNN for African short-range t2m
    Prefer containers/Apptainer.def in new docs - this file is an alias.

    Hardware: CPU supported; GPU not required.
    Validated: analysis-forced African t2m (+6 h primary).
    Not supported: free-running forecast, 10-day forecast, full 65-channel state.

    Checkpoint must be bind-mounted to /opt/lapai-forecast/models/
    (student_global_stable_v5.ckpt is not shipped inside the .sif).

    Examples:
      singularity run -B "$PWD/models:/opt/lapai-forecast/models" mvula-v5.sif info
      singularity run -B "$PWD/models:/opt/lapai-forecast/models" mvula-v5.sif bench

%files
    pyproject.toml /opt/lapai-forecast/pyproject.toml
    requirements.txt /opt/lapai-forecast/requirements.txt
    requirements_streamlit.txt /opt/lapai-forecast/requirements_streamlit.txt
    README.md /opt/lapai-forecast/README.md
    infer.py /opt/lapai-forecast/infer.py
    run_mvula.py /opt/lapai-forecast/run_mvula.py
    streamlit_status.py /opt/lapai-forecast/streamlit_status.py
    lapai_inference /opt/lapai-forecast/lapai_inference
    utils /opt/lapai-forecast/utils
    evaluation /opt/lapai-forecast/evaluation
    training /opt/lapai-forecast/training
    inference /opt/lapai-forecast/inference
    scripts /opt/lapai-forecast/scripts
    configs /opt/lapai-forecast/configs
    reports /opt/lapai-forecast/reports
    students /opt/lapai-forecast/students
    containers /opt/lapai-forecast/containers
    docs /opt/lapai-forecast/docs

%environment
    export LAPAI_REPO=/opt/lapai-forecast
    export PYTHONPATH=/opt/lapai-forecast
    export CUDA_VISIBLE_DEVICES=
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
    export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}
    export PATH=/usr/local/bin:$PATH

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip \
        build-essential ca-certificates curl git \
        && rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/python3 /usr/local/bin/python
    python3 -m pip install --upgrade pip setuptools wheel

    mkdir -p /opt/lapai-forecast/models

    python3 -m pip install --no-cache-dir \
        torch --index-url https://download.pytorch.org/whl/cpu

    cd /opt/lapai-forecast
    python3 -m pip install --no-cache-dir -e ".[dev,data,ort]"
    python3 -m pip install --no-cache-dir -r requirements_streamlit.txt
    python3 -m pip install --no-cache-dir psutil

%runscript
    cd /opt/lapai-forecast
    exec python3 /opt/lapai-forecast/run_mvula.py "$@"

%startscript
    cd /opt/lapai-forecast
    exec python3 /opt/lapai-forecast/run_mvula.py dashboard
