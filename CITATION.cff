  - family-names: Mathekga
    given-names: Samuel
  - family-names: Elim
    given-names: Gabriel
  - family-names: Sichone
    given-names: Fima
keywords:
  - weather forecasting
  - AIFS
  - Africa
  - model compression
  - Code for Earth
