#!/bin/bash
#PBS -N lapai_trackA
#PBS -P RCHPC
#PBS -q gpu_1
#PBS -l select=1:ncpus=9:ngpus=1:node_type=32GB
#PBS -l walltime=06:00:00
#PBS -o lapai_trackA.o
#PBS -e lapai_trackA.e
#PBS -j oe
#PBS -k oe
#
# Submit from LapAI repo root (directory containing pbs/ and training/):
#   cd ~/repos/lapai-forecast && qsub pbs/trackA.pbs
#
# Dry-run (print operator hints only; no training):
#   qsub -v LAPAI_TRACKA_DRY=1 pbs/trackA.pbs
#
# Teacher inference smoke gate (interactive): bash scripts/lapai_inference_gate.sh

set -euo pipefail
cd "${PBS_O_WORKDIR:?submit from lapai-forecast repo root}" || exit 1

JOB_NUM=$(echo "${PBS_JOBID}" | cut -d'.' -f1)
export ANEMOI_BASE_SEED="${JOB_NUM}"

source pbs/inc_conda_lengau.sh
lapai_load_cuda_gpu

# Unified lustre env: anemoi-training 0.14 / anemoi-models 0.16 / anemoi-inference 0.11
# with the glibc-2.17 scikit-learn 1.7.2 fix (scripts/install_sklearn_fix.sh).
# This removes the train(CHPC 0.11)/infer(lustre 0.16) checkpoint version skew so the
# coarsened student loads cleanly for forecasting on the same stack.
export LAPAI_PYTHON="${LAPAI_PYTHON:-/home/msovara/lustre/dev/lapai-anemoi/bin/python}"
if [[ ! -x "${LAPAI_PYTHON}" ]]; then
  echo "ERROR: lustre env python not found/executable: ${LAPAI_PYTHON}" >&2
  echo "       set LAPAI_PYTHON or rebuild the lapai-anemoi venv." >&2
  exit 1
fi
export PATH="$(dirname "${LAPAI_PYTHON}"):${PATH}"
export HYDRA_FULL_ERROR=1
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

echo "[lapai trackA] host=$(hostname) job=${JOB_NUM} ANEMOI_BASE_SEED=${ANEMOI_BASE_SEED} LAPAI_PYTHON=${LAPAI_PYTHON} LAPAI_TRACKA_DRY=${LAPAI_TRACKA_DRY:-0}"

export LAPAI_TEACHER_CONFIG="${LAPAI_TEACHER_CONFIG:-configs/teacher_n320_gt6.yaml}"
export LD_LIBRARY_PATH="${HOME}/.conda/envs/grib_env/lib:${LD_LIBRARY_PATH:-}"

if [[ "${LAPAI_SKIP_GATE:-0}" != 1 ]]; then
  echo "[lapai trackA] inference gate (teacher smoke)..."
  # Gate may use lustre inference stack if CHPC env lacks teacher deps.
  GATE_PYTHON="${LAPAI_GATE_PYTHON:-/home/msovara/lustre/dev/lapai-anemoi/bin/python}"
  if [[ -x "${GATE_PYTHON}" ]]; then
    LAPAI_PYTHON="${GATE_PYTHON}" bash scripts/lapai_inference_gate.sh
  else
    LAPAI_PYTHON="${LAPAI_PYTHON}" bash scripts/lapai_inference_gate.sh
  fi
fi

CFG="${LAPAI_TRACKA_CONFIG:-configs/trackA_coarsen.yaml}"

if [[ "${LAPAI_TRACKA_DRY:-0}" == 1 ]]; then
  exec "${LAPAI_PYTHON}" training/train_trackA.py --step coarsen --config "${CFG}" --suggest-invocation
fi

exec "${LAPAI_PYTHON}" training/train_trackA.py --step coarsen --config "${CFG}"
