#!/bin/bash
#PBS -N lapai_aifs_infer
#PBS -l select=1:ncpus=8:ngpus=1
#
# Teacher AIFS inference on a GPU node (after checkpoint download).
# Submit from lapai-forecast repo root:
#   qsub pbs/inference_aifs_teacher.pbs
#
# Dry-run (render YAML + print command only):
#   qsub -v LAPAI_AIFS_INFER_DRY=1 pbs/inference_aifs_teacher.pbs
#
# Alternate inference YAML (e.g. netcdf_example after you customise output):
#   qsub -v LAPAI_INFER_TEMPLATE=configs/inference_aifs_netcdf_example.yaml pbs/inference_aifs_teacher.pbs
#
# To pass extra flags reliably, run interactively or edit this script; PBS -v
# word-splitting makes multi-arg env vars fragile.
#
# Operator minimal path: reports/RUNBOOK_BASELINE_LENGAU.md -> Minimal copy-paste path

set -euo pipefail
cd "${PBS_O_WORKDIR:?submit from lapai-forecast repo root}" || exit 1

source pbs/inc_conda_lengau.sh
lapai_load_cuda_gpu
lapai_activate_track_a

echo "[lapai] PBS_O_WORKDIR=${PWD} LAPAI_INFER_TEMPLATE=${LAPAI_INFER_TEMPLATE:-} LAPAI_AIFS_INFER_DRY=${LAPAI_AIFS_INFER_DRY:-0}"

infer_py=( python scripts/run_aifs_inference.py )
if [[ -n "${LAPAI_INFER_TEMPLATE:-}" ]]; then
  infer_py+=( --template "${LAPAI_INFER_TEMPLATE}" )
fi

if [[ "${LAPAI_AIFS_INFER_DRY:-0}" == 1 ]]; then
  exec "${infer_py[@]}" --dry-run
fi
exec "${infer_py[@]}"
