#!/bin/bash
#PBS -N lapai_lora
#PBS -P RCHPC
#PBS -q gpu_1
#PBS -l select=1:ncpus=9:ngpus=1:node_type=32GB
# Requires models/student.pt from a prior student training job (or symlink).
#
# Pipeline order: docs/LENGAU.md -> Phase 0 teacher inference -> Track B student -> LoRA.

set -euo pipefail
cd "${PBS_O_WORKDIR:?submit from lapai-forecast repo root}" || exit 1

source pbs/inc_conda_lengau.sh
lapai_load_cuda_gpu
lapai_activate_track_b

exec python training/train_lora.py --student_ckpt models/student.pt --device cuda
