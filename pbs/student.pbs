#!/bin/bash
#PBS -N lapai_student
#PBS -P RCHPC
#PBS -q gpu_1
#PBS -l select=1:ncpus=9:ngpus=1:node_type=32GB
#
# Submit from lapai-forecast repo root.
# TRACK_B defaults to lapai-credit (PyTorch+CUDA stack). Create via:
#   conda env create -f environment-credit-lengau.yml
#
# Teacher handoff (Track A K1): models/teacher_pruned.ckpt — see reports/TRACKA_REPORT.md
# Checklist: reports/TRACKB_START.md
#
# Ops index: docs/LENGAU.md - complete Phase 0 teacher inference first (RUNBOOK_BASELINE_LENGAU.md).

set -euo pipefail
cd "${PBS_O_WORKDIR:?submit from lapai-forecast repo root}" || exit 1

source pbs/inc_conda_lengau.sh
lapai_load_cuda_gpu
lapai_activate_track_b

test -e models/teacher_pruned.ckpt || {
  echo "ERROR: models/teacher_pruned.ckpt missing (expected K1 symlink). See reports/TRACKA_REPORT.md"
  exit 1
}

exec python training/train_student.py \
  --config configs/student_global.yaml \
  --epochs "${LAPAI_STUDENT_EPOCHS:-100}" \
  --device cuda \
  --out models/student_global.ckpt
