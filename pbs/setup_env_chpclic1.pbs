#!/bin/bash
#PBS -N lapai_setup_conda_cli1
#PBS -P RCHPC
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=48GB
#PBS -l walltime=8:00:00
#PBS -l place=scatter:excl
#PBS -W x=FLAGS:ADVRES:chpclic1
#
# Create lapai-anemoi + lapai-credit via scripts/setup_lengau_envs.sh on node chpclic1.
# - Project code: RCHPC (#PBS -P in each lapai-forecast/pbs/*.pbs script).
# - chpclic1 has RAM + outbound network for conda/pip; login-node solves often get OOM;
#   many non-interactive smp/serial allocations have no outbound HTTPS.
#
# Submit from lapai-forecast repo root:
#   qsub pbs/setup_env_chpclic1.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:?submit from lapai-forecast repo root}" || exit 1

exec bash scripts/setup_lengau_envs.sh
