# Cross-platform text: normalize line endings on commit
* text=auto eol=lf

# Explicit text types
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.pbs  text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf
*.def  text eol=lf
Dockerfile text eol=lf
