# LapAI-Forecast — gitignore (scoped to this subtree)

# --- Data and model artefacts (large, regenerable) ---
data/
# Ignore model weights by default; ship frozen v5 student for Path A/B end users.
models/*
!models/student_global_stable_v5.ckpt
logs/
*.zarr/
*.nc
*.grib
*.grib2
*.idx
*.ckpt
!models/student_global_stable_v5.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.sif

# --- Reports artefacts (keep .md, drop generated assets) ---
reports/**/*.png
reports/**/*.pdf
reports/**/*.html
!reports/.gitkeep
# Close-out draft paper PDF (explicitly published)
!reports/DRAFT_PAPER_MVULA_V5.pdf
# Packaged publication figures (already tracked / needed for paper + README)
!reports/figures/
!reports/figures/**

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.conda/
conda-meta/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Linters / type checkers ---
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Hydra / Lightning / W&B ---
outputs/
multirun/
wandb/
lightning_logs/

# --- Offline pip wheelhouses (transient, regenerable) ---
wheelhouse*/
*.whl

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*_token
.cdsapirc
credentials.json
**/secrets/

# --- Local scratch / probes (not for public tree) ---
_hf_space_check/
reports/figures/_fig11_*
reports/figures/_diag_*

# --- Upstream clones (use git submodule instead of vendoring) ---
vendor/
